{
  "manifest_version": 3,
  "name": "ScamCheck - Quét tin nhắn",
  "version": "1.4.6",
  "description": "AI Auto Guard tùy chọn cho trang đang mở; vẫn hỗ trợ khoanh vùng, OCR, RAG và đối chiếu dự phòng.",
  "action": {
    "default_title": "ScamCheck",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "offscreen",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://scamcheck-c3chuyenhvt.vercel.app/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "https://scamcheck-c3chuyenhvt.vercel.app/*",
        "https://scamcheck-azure.vercel.app/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "offline-patterns.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'; connect-src 'self' https://scamcheck-c3chuyenhvt.vercel.app"
  }
}
