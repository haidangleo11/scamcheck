{
  "manifest_version": 3,
  "name": "ScamCheck - Quét tin nhắn",
  "version": "1.0.0",
  "description": "Khoanh vùng tin nhắn trên trang web, OCR ngay trên máy và gửi phần chữ để AI đánh giá dấu hiệu lừa đảo.",
  "key": "",
  "action": {
    "default_title": "ScamCheck",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "offscreen",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://scamcheck-tlov.vercel.app/*",
    "https://tessdata.projectnaptha.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self' blob:; connect-src 'self' https://scamcheck-tlov.vercel.app https://tessdata.projectnaptha.com"
  }
}
