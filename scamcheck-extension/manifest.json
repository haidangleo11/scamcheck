{
  "manifest_version": 3,
  "name": "ScamCheck - Quét tin nhắn",
  "version": "1.0.0",
  "description": "Khoanh vùng tin nhắn trên trang web, OCR ngay trên máy và gửi phần chữ để AI đánh giá dấu hiệu lừa đảo.",
  "key": "",
  "action": {
    "default_title": "ScamCheck",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "offscreen",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://scamcheck-c3chuyenhvt.vercel.app/*",
    "https://tessdata.projectnaptha.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self' blob:; connect-src 'self' https://scamcheck-c3chuyenhvt.vercel.app https://tessdata.projectnaptha.com"
  }
}
